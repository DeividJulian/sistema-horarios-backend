DATABASE_URL=postgresql+psycopg://usuario:contraseña@host:puerto/base

# Signs the session tokens and the login codes (JWT_SECRET, the old name, still works)
SECRET_KEY=una-cadena-larga-y-aleatoria
TOKEN_HORAS=8

# First administrator: created on startup if it doesn't exist; enters with the code sent to this email
ADMIN_EMAIL=tu-correo@gmail.com
ADMIN_NAME=Administrador

# Login codes
CODIGO_MINUTOS=10
CODIGO_INTENTOS=5
CODIGO_ESPERA_SEGUNDOS=30

# Email delivery: consola (local, prints the code) | memoria (tests) | smtp | brevo (production)
EMAIL_BACKEND=consola
EMAIL_FROM=tu-correo@gmail.com
EMAIL_FROM_NAME=Horarios y Aulas
# Brevo API key (starts with xkeysib-); only with EMAIL_BACKEND=brevo
BREVO_API_KEY=
# Only with EMAIL_BACKEND=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
